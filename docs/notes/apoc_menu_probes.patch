+    case 6: return !S->logic && p >= 0x78 && p <= 0xCB;                   /* top 2D (bust-up, stats, windows) */
+    case 7: return !S->logic && ((p >= 0x6B && p <= 0x77) || (p >= 0xCC && p <= 0xE4));  /* 3D, both eyes */
