+
+/* stick axis -> [-1, 1] with dead zone and a quadratic response */
+static float axis(int v)
+{
+    float f = (float)v * (1.0f / 146.0f);       /* the C-stick reports about +-0x9C */
+    float a = f < 0.0f ? -f : f;
+    if (a <= 0.15f) return 0.0f;
+    a = (a - 0.15f) * (1.0f / 0.85f);
+    if (a > 1.0f) a = 1.0f;
+    a *= a;
+    return f < 0.0f ? -a : a;
