+
+static int send_sync(u32 h)
+{
+    register u32 r0 __asm__("r0") = h;
+    __asm__ volatile("svc 0x32" : "+r"(r0) : : "r1", "r2", "r3", "r12", "memory");
+    return (int)r0;
